# Plantilla de configuración.
# Copiá este archivo con el nombre ".env" y completá tus valores.
# El .env NO se sube a Git (está en .gitignore); este .env.example sí,
# para que cada integrante sepa qué variables tiene que definir.

# Clave para firmar las cookies de sesión. Poné un texto largo y aleatorio.
# Se puede generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio

# Conexión a MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tesis2026
DB_USER=tesis_app
DB_PASSWORD=la-misma-clave-que-pusiste-en-crear_usuario_app.sql
